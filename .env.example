# Copy to .env.local (never committed). Server/script use only — never prefix with NEXT_PUBLIC_.
# Personal access token with the file_versions:read scope: Figma → Settings → Security → Personal access tokens
FIGMA_ACCESS_TOKEN=your_token_here
# From the file URL: figma.com/design/<FILE_KEY>/...
FIGMA_FILE_KEY=your_file_key_here
