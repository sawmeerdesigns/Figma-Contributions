{
  "name": "figma-contributions",
  "version": "1.0.0",
  "private": true,
  "description": "A GitHub-style contribution graph for your Figma activity, built locally from version history.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sawmeerdesigns/Figma-Contributions.git"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "sync": "node --env-file-if-exists=.env.local scripts/sync.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "type": "module"
}
