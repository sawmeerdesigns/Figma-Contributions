# Copy to .env.local (never committed). Server/script use only — never prefix with NEXT_PUBLIC_.
# Personal access token with the file_versions:read and current_user:read scopes: Figma → Settings → Security → Personal access tokens
FIGMA_ACCESS_TOKEN=your_token_here
# Files to count, comma-separated: bare keys (figma.com/design/<FILE_KEY>/...) or full file URLs
FIGMA_FILE_KEYS=your_file_key_here
